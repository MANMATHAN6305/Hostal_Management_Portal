PORT=5000
NODE_ENV=production

DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_SSL=false

JWT_SECRET=replace-with-a-strong-secret
FRONTEND_URL=https://your-frontend-service.onrender.com
BACKEND_URL=https://your-backend-service.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-service.onrender.com/api/auth/google/callback
# Optional comma-separated list of additional allowed frontend origins.
# Example: https://hostal-management-portal.onrender.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=
